# ---------- TMDB (required for the real catalogue) ----------
# RECOMMENDED (production, Vercel): keep the credential on the server. Set these in Vercel > Settings >
# Environment Variables WITHOUT the VITE_ prefix, and turn the proxy on for the browser bundle:
VITE_TMDB_PROXY=true
TMDB_READ_TOKEN=
# TMDB_API_KEY=            # alternative to TMDB_READ_TOKEN (v3 key)

# LEGACY / quick local test only: VITE_ variables are compiled into the public JavaScript bundle,
# so anyone can read them. Do not use for a deployed site you care about.
# VITE_TMDB_READ_TOKEN=
# VITE_TMDB_API_KEY=

# ---------- Supabase (optional; enables accounts and shared community reviews) ----------
# Project URL and the PUBLIC anon key only. Never put the service_role key in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
